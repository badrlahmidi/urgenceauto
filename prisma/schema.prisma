datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VISITOR
  PRO
  ADMIN
}

enum ProfessionalStatus {
  PENDING
  APPROVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  passwordHash  String?
  role          Role      @default(VISITOR)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Professional {
  id          String             @id @default(cuid())
  nameAr      String
  nameFr      String
  slug        String             @unique
  categoryId  String
  category    Category           @relation(fields: [categoryId], references: [id])
  whatsapp    String
  lat         Float?
  long        Float?
  images      String[]           @default([])
  status      ProfessionalStatus @default(PENDING)
  reviews     Review[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Category {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameAr        String
  nameFr        String
  icon          String?
  professionals Professional[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SiteSettings {
  id            String   @id @default("global")
  heroTitleFr   String   @default("Urgence Auto Marrakech")
  heroTitleAr   String   @default("طوارئ السيارات مراكش")
  heroSubFr     String   @default("Trouvez instantanément les meilleurs professionnels de l'automobile autour de vous.")
  heroSubAr     String   @default("ابحث على الفور عن أفضل المتخصصين في السيارات من حولك.")
  contactEmail  String?
  contactPhone  String?
  updatedAt     DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  comment   String?
  proId     String
  pro       Professional @relation(fields: [proId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
