# PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/urgenceauto?schema=public"

# Auth.js / NextAuth
# Generate a secret using: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-auth-key-change-me-in-production"

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
